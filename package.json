{
  "name": "serial-port-terminal",
  "displayName": "Serial Port Terminal",
  "description": "An interactive serial port terminal (experiment)",
  "version": "0.0.1",
  "publisher": "ziqiang",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialPortTerminalSideBar",
          "title": "%serialPortTerminal.SideBar.title%",
          "icon": "$(keybindings-editor-label-icon)",
          "command": "serialPortTerminal.open"
        }
      ]
    },
    "views": {
      "serialPortTerminalSideBar": [
        {
          "id": "serialPortDeviceList",
          "name": "%serialPortDeviceList.View.title%",
          "icon": "$(device-desktop)",
          "initialSize": 50
        }
      ]
    },
    "commands": [
      {
        "command": "serialPortDeviceList.refresh",
        "title": "%serialPortDeviceList.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "serialPortDevice.connect",
        "title": "%serialPortDevice.connect.title%",
        "icon": "$(remote)"
      },
      {
        "command": "serialPortDevice.disconnect",
        "title": "%serialPortDevice.disconnect.title%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "serialPortDeviceList.refresh",
          "when": "view == serialPortDeviceList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "serialPortDevice.connect",
          "when": "view == serialPortDeviceList && viewItem == serialPortDevice.disconnected",
          "group": "inline"
        },
        {
          "command": "serialPortDevice.disconnect",
          "when": "view == serialPortDeviceList && viewItem == serialPortDevice.connected",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
