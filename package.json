{
  "name": "serial-port-terminal",
  "displayName": "Serial Port Terminal",
  "description": "An interactive serial port terminal",
  "version": "1.2.2",
  "publisher": "ziqiang",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziqiang-zhu/vscode-serial-port-terminal.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/ziqiang-zhu/vscode-serial-port-terminal#readme",
  "bugs": {
    "url": "https://github.com/ziqiang-zhu/vscode-serial-port-terminal/issues"
  },
  "keywords": [
    "serial",
    "serial-port",
    "terminal",
    "uart",
    "log"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialPortTerminalSideBar",
          "title": "%serialPortTerminal.SideBar.title%",
          "icon": "$(debug-console)"
        }
      ]
    },
    "views": {
      "serialPortTerminalSideBar": [
        {
          "id": "serialPortDeviceList",
          "name": "%serialPortDeviceList.View.title%",
          "icon": "$(device-desktop)",
          "initialSize": 50
        },
        {
          "id": "serialPortMacroList",
          "name": "%serialPortMacroList.View.title%",
          "icon": "$(symbol-text)"
        }
      ]
    },
    "commands": [
      {
        "command": "serialPortDeviceList.refresh",
        "title": "%serialPortDeviceList.refresh.title%",
        "category": "Serial Port Terminal",
        "icon": "$(refresh)"
      },
      {
        "command": "serialPortDevice.connect",
        "title": "%serialPortDevice.connect.title%",
        "category": "Serial Port Terminal",
        "icon": "$(remote)"
      },
      {
        "command": "serialPortDevice.disconnect",
        "title": "%serialPortDevice.disconnect.title%",
        "category": "Serial Port Terminal",
        "icon": "$(close)"
      },
      {
        "command": "serialPortQuickConfig.add",
        "title": "%serialPortQuickConfig.add.title%",
        "category": "Serial Port Terminal"
      },
      {
        "command": "serialPortQuickConfig.rename",
        "title": "%serialPortQuickConfig.rename.title%",
        "category": "Serial Port Terminal"
      },
      {
        "command": "serialPortQuickConfig.remove",
        "title": "%serialPortQuickConfig.remove.title%",
        "category": "Serial Port Terminal"
      },
      {
        "command": "serialPortLog.start",
        "title": "%serialPortLog.start.title%",
        "category": "Serial Port Terminal",
        "icon": "$(save)"
      },
      {
        "command": "serialPortLog.pause",
        "title": "%serialPortLog.pause.title%",
        "category": "Serial Port Terminal",
        "icon": "$(debug-pause)"
      },
      {
        "command": "serialPortLog.resume",
        "title": "%serialPortLog.resume.title%",
        "category": "Serial Port Terminal",
        "icon": "$(debug-continue)"
      },
      {
        "command": "serialPortLog.stop",
        "title": "%serialPortLog.stop.title%",
        "category": "Serial Port Terminal",
        "icon": "$(debug-stop)"
      },
      {
        "command": "serialPortLog.openDirectory",
        "title": "%serialPortLog.openDirectory.title%",
        "category": "Serial Port Terminal",
        "icon": "$(folder-opened)"
      },
      {
        "command": "serialPortMacro.add",
        "title": "%serialPortMacro.add.title%",
        "category": "Serial Port Terminal",
        "icon": "$(add)"
      },
      {
        "command": "serialPortMacro.send",
        "title": "%serialPortMacro.send.title%",
        "category": "Serial Port Terminal",
        "icon": "$(play)"
      },
      {
        "command": "serialPortMacro.remove",
        "title": "%serialPortMacro.remove.title%",
        "category": "Serial Port Terminal",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "serialPortDeviceList.refresh",
          "when": "view == serialPortDeviceList",
          "group": "navigation"
        },
        {
          "command": "serialPortLog.openDirectory",
          "when": "view == serialPortDeviceList",
          "group": "navigation"
        },
        {
          "command": "serialPortLog.start",
          "when": "view == terminal && serialPortTerminal.focus && !serialPortTerminal.recording",
          "group": "navigation"
        },
        {
          "command": "serialPortLog.pause",
          "when": "view == terminal && serialPortTerminal.focus && serialPortTerminal.recording && !serialPortTerminal.paused",
          "group": "navigation"
        },
        {
          "command": "serialPortLog.resume",
          "when": "view == terminal && serialPortTerminal.focus && serialPortTerminal.recording && serialPortTerminal.paused",
          "group": "navigation"
        },
        {
          "command": "serialPortLog.stop",
          "when": "view == terminal && serialPortTerminal.focus && serialPortTerminal.recording",
          "group": "navigation"
        },
        {
          "command": "serialPortMacro.add",
          "when": "view == serialPortMacroList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "serialPortDevice.connect",
          "when": "view == serialPortDeviceList && viewItem == serialPortDevice.disconnected",
          "group": "inline"
        },
        {
          "command": "serialPortDevice.disconnect",
          "when": "view == serialPortDeviceList && viewItem == serialPortDevice.connected",
          "group": "inline"
        },
        {
          "command": "serialPortQuickConfig.add",
          "when": "view == serialPortDeviceList && viewItem =~ /^serialPortDevice\\./"
        },
        {
          "command": "serialPortQuickConfig.rename",
          "when": "view == serialPortDeviceList && viewItem == serialPortQuickConfig"
        },
        {
          "command": "serialPortQuickConfig.remove",
          "when": "view == serialPortDeviceList && viewItem == serialPortQuickConfig"
        },
        {
          "command": "serialPortMacro.send",
          "when": "view == serialPortMacroList && viewItem == serialPortMacro",
          "group": "inline"
        },
        {
          "command": "serialPortMacro.remove",
          "when": "view == serialPortMacroList && viewItem == serialPortMacro"
        }
      ]
    },
    "configuration": {
      "title": "%serialPortTerminal.configuration.title%",
      "properties": {
        "serialPortTerminal.pollingInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 15,
          "description": "%serialPortTerminal.pollingInterval.description%"
        },
        "serialPortTerminal.hotPlugEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%serialPortTerminal.hotPlugEnabled.description%"
        },
        "serialPortTerminal.logDirectory": {
          "type": "string",
          "default": "",
          "description": "%serialPortTerminal.logDirectory.description%"
        },
        "serialPortTerminal.logFilenameTemplate": {
          "type": "string",
          "default": "{device}_{YYYY}{MM}{DD}_{HH}{mm}{ss}.log",
          "pattern": "^[^\\\\/:*?\"<>|]+$",
          "patternErrorMessage": "%serialPortTerminal.logFilenameTemplate.patternError%",
          "description": "%serialPortTerminal.logFilenameTemplate.description%"
        },
        "serialPortTerminal.logTimestampEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%serialPortTerminal.logTimestampEnabled.description%"
        },
        "serialPortTerminal.logTimestampFormat": {
          "type": "string",
          "default": "[{HH}:{mm}:{ss}.{SSS}] ",
          "description": "%serialPortTerminal.logTimestampFormat.description%"
        },
        "serialPortTerminal.logShortcutsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%serialPortTerminal.logShortcutsEnabled.description%"
        },
        "serialPortTerminal.baudRates": {
          "type": "array",
          "items": { "type": "number" },
          "default": [9600, 19200, 38400, 57600, 115200, 230400, 460800, 921600],
          "description": "%serialPortTerminal.baudRates.description%"
        },
        "serialPortTerminal.frameFormats": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["8-N-1", "8-E-1", "8-O-1", "8-N-2", "8-E-2", "8-O-2", "7-N-1", "7-E-1", "7-O-1", "7-N-2"],
          "description": "%serialPortTerminal.frameFormats.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "node scripts/clean-dist.js",
    "vscode:prepublish": "npm run clean && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
